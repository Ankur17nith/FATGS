# FATGS Environment Configuration
# Copy this file to .env for local configuration

# FATGS Backend Server Port
PORT=5001

# TT_TRACKER Integration
# In local development: http://localhost:3000
# In production: https://<deployed-tt-tracker-domain>
TT_TRACKER_URL=http://localhost:3000
TT_TRACKER_IMPORT_ENDPOINT=/api/timetable/import

# Shared Secret for authenticating server-to-server import requests to TT_TRACKER
# Must remain strictly on the backend and never be committed or exposed to the browser
TT_TRACKER_IMPORT_SECRET=development_secret_change_in_production
