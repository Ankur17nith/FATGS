# FATGS Environment Configuration
# Copy this file to .env for local development. In production set these in the host's
# environment settings instead; never commit real values.

# Port the backend listens on (hosts such as Render set this for you)
PORT=5001

# Set to "production" on the deployed backend to get startup warnings about unsafe settings
# NODE_ENV=production

# TT_TRACKER Integration
# Local development: http://localhost:3000
# Production: the public address of the deployed TT_TRACKER, e.g. https://tt-tracker.onrender.com
TT_TRACKER_URL=http://localhost:3000
TT_TRACKER_IMPORT_ENDPOINT=/api/timetable/import

# Shared secret for server-to-server import requests to TT_TRACKER. It must be identical
# to TT_TRACKER_IMPORT_SECRET on the TT_TRACKER side. Keep it on the backend only.
# In production use a long random value (at least 16 characters), for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TT_TRACKER_IMPORT_SECRET=replace-with-a-long-random-secret

# Optional: how long the handoff to TT_TRACKER may take before giving up (milliseconds)
# TT_TRACKER_TIMEOUT_MS=60000

# Production: browser origins allowed to call this API, comma separated.
# Leave unset in development (any origin is allowed).
# CORS_ORIGIN=https://fatgs-web.onrender.com

# Production: directory for state that must survive restarts (generation sessions and
# faculty blocks). Point it at a persistent disk. Unset: files stay inside the repo.
# FATGS_DATA_DIR=/var/data/fatgs
