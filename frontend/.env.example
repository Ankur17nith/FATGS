# Used at build time (Vite). Leave unset in development: requests go to the same origin
# and the dev server proxies /api to the backend.
#
# Production, when the frontend is hosted separately from the backend (for example a
# static site): the public address of the deployed FATGS backend, no trailing slash.
# VITE_API_BASE_URL=https://fatgs-api.onrender.com
